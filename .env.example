# ==============================================
# PostgreSQL
# ==============================================
POSTGRES_DB=mass_notification_db
POSTGRES_USER=notification_user
POSTGRES_PASSWORD=notification_pass_dev
POSTGRES_HOST_PORT=5432

# ==============================================
# RabbitMQ
# ==============================================
RABBITMQ_DEFAULT_USER=notification_rmq
RABBITMQ_DEFAULT_PASS=notification_rmq_dev
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ==============================================
# Application Services (.NET 10)
# ==============================================
API_HOST_PORT=5080
AUTH_API_KEY=dev-admin-api-key-change-me
WORKER_PREFETCH_COUNT=10
WORKER_SIMULATED_FAILURE_RATE=0.15
WORKER_MAX_AUTO_RETRIES=3
